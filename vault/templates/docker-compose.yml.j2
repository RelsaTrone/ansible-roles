version: '3.8'
services:
  vault:
    image: hashicorp/vault:{{ vault_version }}
    container_name: {{ vault_container_name }}
    ports:
      - "{{ vault_port }}:8200"
    volumes:
      - {{ vault_data_dir }}:/vault/file
    environment:
      VAULT_LOCAL_CONFIG: '{"storage": {"file": {"path": "/vault/file"}}, "listener": {"tcp": {"address": "0.0.0.0:8200", "tls_disable": true}}, "ui": true}'
    cap_add:
      - IPC_LOCK
    command: server
    restart: unless-stopped
    mem_limit: 256m
